#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    
    srand(time(NULL));
    int secretNum = (rand() % 99) + 1;
    int n;
    int counter = 0;
    printf("Enter your guess : \n");
    scanf("%d",&n);
    while (n != secretNum) {
        if (n>secretNum) {
            printf("You should lower your guess.\n");
            counter = counter + 1;
        } else {
            printf("You should make it higher.\n");
            counter = counter + 1;
        }
        printf("Enter your new guess : \n");
        scanf("%d",&n);
    }
    printf("You just found the secret number in your %d. try!\n",counter+1);
    

    return 0;
}
